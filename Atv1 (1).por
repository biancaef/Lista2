programa
{
    funcao inicio()
    {
        real compra = 17.00
        real pagamento = 100.00
        real troco

        troco = pagamento - compra

        escreva("Troco: R$ ", troco, "\n")

        escreva("1 nota de R$ 50\n")
        escreva("1 nota de R$ 20\n")
        escreva("1 nota de R$ 10\n")
        escreva("1 moeda de R$ 2\n")
        escreva("1 moeda de R$ 1\n")
    }
}